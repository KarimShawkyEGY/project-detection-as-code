# ATT&CK: T1005 - Data from Local System
# Tactic: Collection
# Severity: Low
index=sysmon host=SOC-WIN11-SPLUN EventCode=1
Image="*powershell*"
"Compress-Archive"
| eval technique="T1005", tactic="Collection", severity="Low"
| table _time, host, Image, CommandLine, User, technique, tactic, severity
