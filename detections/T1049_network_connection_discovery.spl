# ATT&CK: T1049 - System Network Connections Discovery
# Tactic: Discovery
# Severity: Low
index=sysmon host=SOC-WIN11-SPLUN EventCode=1
(Image="*netstat.exe*" OR CommandLine="*net use*" OR CommandLine="*net share*")
| eval technique="T1049", tactic="Discovery", severity="Low"
| table _time, host, Image, CommandLine, User, technique, tactic, severity
