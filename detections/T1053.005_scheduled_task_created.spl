# ATT&CK: T1053.005 - Scheduled Task/Job: Scheduled Task
# Tactic: Persistence
# Severity: High
index=sysmon host=SOC-WIN11-SPLUN EventCode=1
Image="*schtasks*" CommandLine="*/create*"
| eval technique="T1053.005", tactic="Persistence", severity="High"
| table _time, host, Image, EventCode, CommandLine, User, technique, tactic, severity
